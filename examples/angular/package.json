{
  "name": "classy-store-angular-example",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve classy-store-angular-example",
    "build": "ng build classy-store-angular-example",
    "watch": "ng build classy-store-angular-example --watch --configuration development",
    "typecheck": "ngc --project tsconfig.app.json --noEmit",
    "check:integration": "ngc --project ../../packages/classy-store/tests/browser/angular/tsconfig.json --noEmit",
    "build:integration": "ng build angular-integration --configuration development"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@codebelt/classy-store": "workspace:*",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "typescript": "6.0.3"
  }
}
