{
  "name": "classy-store-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "overrides": {
    "@solidjs/babel-plugin": "2.0.0-rc.18",
    "@solidjs/compiler": "2.0.0-rc.18"
  },
  "scripts": {
    "---------- Dev --------------------------------------------------------": "",
    "dev": "bun run --filter @codebelt/classy-store dev",
    "---------- Build ------------------------------------------------------": "",
    "build": "bun run --filter @codebelt/classy-store build",
    "---------- Test --------------------------------------------------------": "",
    "test": "bun run --filter @codebelt/classy-store test",
    "test:browser": "bun run --filter @codebelt/classy-store test:browser",
    "test:frameworks:compatibility": "bun run build && node packages/classy-store/tests/frameworkCompatibility/runCompatibility.mjs",
    "test:angular:compatibility": "bun run build && node packages/classy-store/tests/angularCompatibility/runCompatibility.mjs",
    "test:react:compatibility": "bun run build && node packages/classy-store/tests/compatibility/runCompatibility.mjs",
    "test:react:compiler": "bun run build && node packages/classy-store/tests/compiler/runCompiler.mjs",
    "test:react:memory": "bun run build && bun packages/classy-store/tests/memory/runMemory.ts",
    "test:react:next": "bun run build && node packages/classy-store/tests/next/runNext.mjs",
    "benchmark:react": "bun run build && bun packages/classy-store/tests/performance/runPerformance.ts",
    "---------- Lint --------------------------------------------------------": "",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "bun run --filter @codebelt/classy-store typecheck && bun run --filter @codebelt/classy-store typecheck:scoping && bun run --filter classy-store-svelte-example check:integration && bun run --filter classy-store-vue-example check:integration && bun run --filter classy-store-solid-example typecheck && bun run --filter classy-store-solid-example check:integration && bun run --filter classy-store-angular-example typecheck && bun run --filter classy-store-angular-example check:integration",
    "---------- Release (Changesets) ----------------------------------------": "",
    "changeset": "changeset",
    "changeset:add": "changeset add",
    "changeset:version": "changeset version && biome format --write packages/classy-store/CHANGELOG.md",
    "changeset:publish": "bun run build && changeset publish",
    "changeset:status": "changeset status",
    "prerelease:enter": "changeset pre enter",
    "prerelease:exit": "changeset pre exit",
    "---------- Framework Examples -----------------------------------------": "",
    "react:dev": "cd examples/react && bun run dev",
    "vue:dev": "cd examples/vue && bun run dev",
    "svelte:dev": "cd examples/svelte && bun run dev",
    "solid:dev": "cd examples/solid && bun run dev",
    "angular:dev": "cd examples/angular && bun run start",
    "---------- Docs (Fumadocs)  ------------------------------------------": "",
    "demos:build": "cd examples/react && bun run build.ts --outdir=../../website/public/demos",
    "docs:dev": "bun run --cwd website dev",
    "docs:build": "bun run --cwd website build:pages",
    "docs:test": "bun run --cwd website test:pages",
    "---------- CI / Helper ------------------------------------------------": "",
    "checkall": "bun run lint:fix && bun run test && bun run typecheck",
    "clean": "find . -name node_modules -o -name .next -o -name dist -o -name build | xargs rm -rf",
    "deps": "bun update --interactive --recursive --latest",
    "-----------------------------------------------------------------------": ""
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.29.8"
  }
}
