{
  "name": "website-fumadocs",
  "version": "0.0.50",
  "private": true,
  "scripts": {
    "build:demos": "cd ../examples/react && bun run build.ts --outdir=../../website-fumadocs/public/demos",
    "build": "bun run build:demos && next build --webpack",
    "build:pages": "bun run build:demos && DOCS_BASE_PATH=/classy-store next build --webpack",
    "dev": "bun run build:demos && next dev",
    "start": "serve out",
    "types:check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "cn": "^0.5.0",
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.9",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.7",
    "lucide-react": "^1.59.0",
    "mermaid": "^12.2.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.31",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
