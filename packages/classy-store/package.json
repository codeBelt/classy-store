{
  "name": "@codebelt/classy-store",
  "version": "0.1.1",
  "description": "Class-based reactive state management — ES6 Proxy + immutable snapshots",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeBelt/classy-store.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/react.d.mts",
        "default": "./dist/react/react.mjs"
      },
      "require": {
        "types": "./dist/react/react.d.cts",
        "default": "./dist/react/react.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils/index.d.mts",
        "default": "./dist/utils/index.mjs"
      },
      "require": {
        "types": "./dist/utils/index.d.cts",
        "default": "./dist/utils/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "---------- Dev --------------------------------------------------------": "",
    "dev": "tsdown --watch",
    "---------- Build ------------------------------------------------------": "",
    "build": "tsdown",
    "---------- Test --------------------------------------------------------": "",
    "test": "bun test",
    "---------- Lint --------------------------------------------------------": "",
    "typecheck": "tsc --noEmit",
    "-----------------------------------------------------------------------": ""
  },
  "dependencies": {
    "proxy-compare": "3.0.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.6.1",
    "@types/bun": "1.3.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsdown": "0.20.3",
    "typescript": "5.9.3"
  },
  "keywords": [
    "classy-store",
    "@codebelt/classy-store",
    "classystore",
    "state-management",
    "reactive",
    "proxy",
    "class-based",
    "react",
    "hooks"
  ],
  "license": "MIT",
  "sideEffects": false
}
