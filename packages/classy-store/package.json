{
  "name": "@codebelt/classy-store",
  "version": "0.8.1",
  "description": "Class-based reactive state management — ES6 Proxy + immutable snapshots",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeBelt/classy-store.git",
    "directory": "packages/classy-store"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils/index.d.mts",
        "default": "./dist/utils/index.mjs"
      },
      "require": {
        "types": "./dist/utils/index.d.cts",
        "default": "./dist/utils/index.cjs"
      }
    },
    "./collections": {
      "import": {
        "types": "./dist/collections/index.d.mts",
        "default": "./dist/collections/index.mjs"
      },
      "require": {
        "types": "./dist/collections/index.d.cts",
        "default": "./dist/collections/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/frameworks/react/react.d.mts",
        "default": "./dist/frameworks/react/react.mjs"
      },
      "require": {
        "types": "./dist/frameworks/react/react.d.cts",
        "default": "./dist/frameworks/react/react.cjs"
      }
    },
    "./react/server": {
      "import": {
        "types": "./dist/frameworks/react/server.d.mts",
        "default": "./dist/frameworks/react/server.mjs"
      },
      "require": {
        "types": "./dist/frameworks/react/server.d.cts",
        "default": "./dist/frameworks/react/server.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/frameworks/vue/vue.d.mts",
        "default": "./dist/frameworks/vue/vue.mjs"
      },
      "require": {
        "types": "./dist/frameworks/vue/vue.d.cts",
        "default": "./dist/frameworks/vue/vue.cjs"
      }
    },
    "./svelte": {
      "import": {
        "types": "./dist/frameworks/svelte/svelte.d.mts",
        "default": "./dist/frameworks/svelte/svelte.mjs"
      },
      "require": {
        "types": "./dist/frameworks/svelte/svelte.d.cts",
        "default": "./dist/frameworks/svelte/svelte.cjs"
      }
    },
    "./angular": {
      "import": {
        "types": "./dist/frameworks/angular/angular.d.mts",
        "default": "./dist/frameworks/angular/angular.mjs"
      },
      "require": {
        "types": "./dist/frameworks/angular/angular.d.cts",
        "default": "./dist/frameworks/angular/angular.cjs"
      }
    },
    "./solid": {
      "import": {
        "types": "./dist/frameworks/solid/solid.d.mts",
        "default": "./dist/frameworks/solid/solid.mjs"
      },
      "require": {
        "types": "./dist/frameworks/solid/solid.d.cts",
        "default": "./dist/frameworks/solid/solid.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "---------- Dev --------------------------------------------------------": "",
    "dev": "tsdown --watch",
    "---------- Build ------------------------------------------------------": "",
    "build": "tsdown",
    "---------- Test --------------------------------------------------------": "",
    "test": "bun test src tests/memory/heapSnapshot.test.ts",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts",
    "---------- Lint --------------------------------------------------------": "",
    "typecheck": "tsc --noEmit && tsc --project tests/browser/tsconfig.json --noEmit && tsc --project tests/compiler/tsconfig.json --noEmit && tsc --project tests/performance/tsconfig.json --noEmit && tsc --project tests/memory/tsconfig.json --noEmit && tsc --project tests/next/tsconfig.json --noEmit",
    "typecheck:scoping": "tsc --project ../../examples/react/tsconfig.scoping.json --noEmit",
    "prepublishOnly": "cp ../../README.md .",
    "-----------------------------------------------------------------------": ""
  },
  "dependencies": {
    "proxy-compare": "3.0.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "vue": ">=3.0.0",
    "svelte": ">=4.0.0",
    "@angular/core": ">=17.0.0",
    "solid-js": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/core": "22.2.3",
    "@babel/core": "7.29.7",
    "@happy-dom/global-registrator": "21.0.4",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "react": "19.3.1",
    "react-compiler-runtime": "1.0.0",
    "react-dom": "19.3.1",
    "solid-js": "1.9.17",
    "svelte": "5.55.5",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vue": "3.5.44"
  },
  "keywords": [
    "classy-store",
    "@codebelt/classy-store",
    "classystore",
    "state-management",
    "reactive",
    "proxy",
    "class-based",
    "react",
    "hooks"
  ],
  "license": "MIT",
  "sideEffects": false
}
